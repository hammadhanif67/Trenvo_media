{
  "name": "trenvo-media",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-fonts.mjs && vite-react-ssg build && node scripts/emit-404.mjs && node scripts/apply-csp.mjs && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-build.mjs",
    "brand": "node brand/build-assets.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hero-images": "node scripts/build-hero-images.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run audit && npm run check:seo",
    "fonts": "node scripts/sync-fonts.mjs",
    "check:seo": "node scripts/check-dynamic-seo.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "react-router-dom": "file:vendor/react-router-dom",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "geist": "^1.7.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-react-ssg": "0.9.2"
  },
  "overrides": {
    "vite-react-ssg": {
      "react-router-dom": "$react-router-dom"
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
