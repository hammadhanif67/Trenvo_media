# Copy to .env and fill in when the values exist.
# Vite exposes only VITE_-prefixed vars to the client bundle.

# The production origin, without a trailing slash.
# Required by master.md §21.1 (canonical), §21.6 (absolute og:image) and
# §21.7 (sitemap). Until it is set, the build ships a placeholder host and
# `npm run audit` fails — deliberately, so a guessed domain cannot ship.
#
#   VITE_SITE_ORIGIN=https://example.com   (build)
#   SITE_ORIGIN=https://example.com        (node scripts: sitemap, robots)
VITE_SITE_ORIGIN=
SITE_ORIGIN=
